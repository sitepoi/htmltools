{
  "name": "html-based-tools",
  "version": "0.1.4",
  "private": true,
  "description": "UniconHub html-tool library - taxonomy-organized apps with automated documentation (SSOT + satellites) and one-command release.",
  "scripts": {
    "docs:init": "node scripts/init-docs.js",
    "docs:index-code": "node scripts/refresh-docs-index.js",
    "docs:index-shots": "node scripts/refresh-docs-index.js --shots",
    "docs:refresh-shells": "node scripts/init-docs.js --refresh-shells",
    "screenshots": "node scripts/capture-screenshots.js",
    "webpage:export": "node scripts/export-webpage.js",
    "ship:cms": "node scripts/ship-cms.js",
    "catalog:build": "node scripts/build-catalog-page.js",
    "docs:generate": "node scripts/generate-docs.js",
    "ssot:index": "node scripts/build-ssot-index.js",
    "ssot:check": "node scripts/check-ssot-assets.js",
    "tools:changed": "node scripts/list-changed-tools.js",
    "ai:test": "node scripts/ai-test.js",
    "rel": "node scripts/release.js"
  },
  "engines": {
    "node": ">=18"
  }
}
