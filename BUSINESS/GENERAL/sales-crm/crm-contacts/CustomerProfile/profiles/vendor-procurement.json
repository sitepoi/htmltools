          "icon": "user",
          "fields": [
            { "id": "vendorContactRole", "label": "Role", "type": "text", "width": "half" },
            { "id": "vendorContactPhone", "label": "Phone", "type": "phone", "width": "half" },
            { "id": "vendorContactEmail", "label": "Email", "type": "email", "width": "half" },
            { "id": "vendorContactMethod", "label": "Preferred contact", "type": "select", "width": "half", "options": ["Email", "Phone", "Portal", "Other"] },
            { "id": "vendorContactNotes", "label": "Contact notes", "type": "textarea", "width": "full", "rows": 3 }
          ]
