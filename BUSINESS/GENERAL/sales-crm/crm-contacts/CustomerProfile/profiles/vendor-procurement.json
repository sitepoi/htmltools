  "definitions": [
    {
      "key": "supplier-profile",
      "name": "Supplier assessment",
      "description": "Categories, terms and compliance details",
      "sections": [
        {
          "id": "supplier-assessment",
          "title": "Supplier assessment",
          "icon": "truck",
          "description": "Administrative and commercial vendor details. Do not store bank credentials here.",
          "fields": [
            { "id": "vendorCategory", "label": "Category", "type": "multiselect", "width": "full", "required": true, "options": ["Materials", "Equipment", "Software", "Services", "Logistics", "Facilities", "Other"] },
            { "id": "vendorLeadTime", "label": "Typical lead time (days)", "type": "number", "width": "half" },
            { "id": "vendorPaymentTerms", "label": "Payment terms", "type": "select", "width": "half", "options": ["Prepaid", "Net 15", "Net 30", "Net 45", "Net 60", "Other"] },
            { "id": "vendorInsuranceExpiry", "label": "Insurance expiry", "type": "date", "width": "half" },
            { "id": "vendorCertifications", "label": "Certifications", "type": "multiselect", "width": "full", "options": ["ISO 9001", "ISO 27001", "Safety certification", "Quality certification", "Other"] },
            { "id": "vendorQualityRating", "label": "Quality rating (1-5)", "type": "number", "width": "half" },
            { "id": "vendorAssessmentNotes", "label": "Assessment notes", "type": "textarea", "width": "full", "rows": 3 }
          ]
        }
      ]
    },
    {
      "key": "contractor-profile",
      "name": "Contractor assessment",
      "description": "Licence, insurance and site checks",
      "sections": [
        {
          "id": "contractor-assessment",
          "title": "Contractor assessment",
          "icon": "hardHat",
          "fields": [
            { "id": "vendorTrade", "label": "Trade", "type": "select", "width": "half", "options": ["Electrical", "Plumbing", "HVAC", "Construction", "Cleaning", "Security", "Other"] },
            { "id": "vendorLicence", "label": "Licence number", "type": "text", "width": "half" },
            { "id": "vendorContractorInsurance", "label": "Insurance expiry", "type": "date", "width": "half" },
            { "id": "vendorSafetyInduction", "label": "Safety induction date", "type": "date", "width": "half" },
            { "id": "vendorAvailability", "label": "Availability", "type": "select", "width": "half", "options": ["Available", "Limited", "Booked", "Unavailable"] },
            { "id": "vendorContractorNotes", "label": "Site notes", "type": "textarea", "width": "full", "rows": 3 }
          ]
        }
      ]
    },
    {
      "key": "vendor-contact",
      "name": "Vendor contact",
      "description": "Role and contact preferences",
      "sections": [
        {
