            { "id": "agencyAccountNotes", "label": "Account notes", "type": "textarea", "width": "full", "rows": 3 }
          ]
        }
      ]
    },
    {
      "key": "prospect-brief",
      "name": "Prospect brief",
      "description": "Goals, scope, budget and decision process",
      "sections": [
        {
          "id": "prospect-brief-details",
          "title": "Prospect brief",
          "icon": "star",
          "fields": [
            { "id": "agencyGoal", "label": "Primary goal", "type": "textarea", "width": "full", "rows": 4, "required": true },
            { "id": "agencyScope", "label": "Scope needed", "type": "multiselect", "width": "full", "options": ["Brand strategy", "Design", "Web development", "Content", "Paid media", "Social media", "Consulting", "Other"] },
            { "id": "agencyBudget", "label": "Budget range", "type": "select", "width": "half", "options": ["Under 5k", "5k-15k", "15k-50k", "50k-100k", "100k+", "Not sure"] },
            { "id": "agencyTimeline", "label": "Target timeline", "type": "select", "width": "half", "options": ["Immediate", "1-3 months", "3-6 months", "6+ months", "Not sure"] },
            { "id": "agencyDecisionMaker", "label": "Decision maker", "type": "text", "width": "half" },
            { "id": "agencyChannels", "label": "Current channels", "type": "multiselect", "width": "full", "options": ["Website", "Email", "Social", "Paid search", "Events", "Referral", "Other"] },
            { "id": "agencyProspectNotes", "label": "Brief notes", "type": "textarea", "width": "full", "rows": 3 }
          ]
        }
      ]
    },
    {
      "key": "supplier-profile",
      "name": "Supplier profile",
      "description": "Services, rates and availability",
      "sections": [
        {
          "id": "supplier-details",
          "title": "Supplier details",
          "icon": "users",
          "fields": [
            { "id": "agencySupplierServices", "label": "Services", "type": "multiselect", "width": "full", "options": ["Design", "Development", "Copywriting", "Photography", "Video", "Production", "Other"] },
            { "id": "agencySupplierRate", "label": "Rate", "type": "text", "width": "half", "placeholder": "Hourly, day rate or project range" },
            { "id": "agencySupplierAvailability", "label": "Availability", "type": "select", "width": "half", "options": ["Available now", "Limited", "Booked", "Not available"] },
            { "id": "agencySupplierPortfolio", "label": "Portfolio link", "type": "url", "width": "half" },
