  "definitions": [
    {
      "key": "client-intake",
      "name": "Client intake",
      "description": "Administrative contact, scheduling and funding details",
      "sections": [
        {
          "id": "client-admin",
          "title": "Client administration",
          "icon": "note",
          "description": "Practical details for scheduling and contact. Clinical notes belong in a separate secure tool.",
          "fields": [
            { "id": "therapyPreferredLanguage", "label": "Preferred language", "type": "text", "width": "half" },
            { "id": "therapyAppointmentMode", "label": "Appointment mode", "type": "select", "width": "half", "options": ["In person", "Video", "Phone", "No preference"] },
            { "id": "therapyAvailability", "label": "Preferred times", "type": "multiselect", "width": "full", "options": ["Weekday mornings", "Weekday afternoons", "Weekday evenings", "Saturday"] },
            { "id": "therapyFunding", "label": "Funding source", "type": "select", "width": "half", "options": ["Self-funded", "Private insurance", "Public funding", "Employer", "Other"] },
            { "id": "therapyFundingReference", "label": "Funding reference", "type": "text", "width": "half", "hint": "Only the administrative reference, not clinical information." },
            { "id": "therapyEmergencyName", "label": "Emergency contact name", "type": "text", "width": "half" },
            { "id": "therapyEmergencyPhone", "label": "Emergency contact phone", "type": "phone", "width": "half" },
            { "id": "therapyAccessibility", "label": "Accessibility needs", "type": "textarea", "width": "full", "rows": 3, "hint": "Practical access needs only. Do not record clinical details." },
            { "id": "therapyContactConsent", "label": "Consent to contact", "type": "checkbox", "width": "half" }
          ]
        }
      ]
    },
    {
      "key": "referrer-contact",
      "name": "Referrer contact",
      "description": "Organisation, role and contact route",
      "sections": [
        {
          "id": "referrer-details",
          "title": "Referrer details",
          "icon": "users",
          "fields": [
            { "id": "referrerOrganisation", "label": "Organisation", "type": "text", "width": "half" },
            { "id": "referrerRole", "label": "Role", "type": "text", "width": "half" },
            { "id": "referrerPhone", "label": "Phone", "type": "phone", "width": "half" },
            { "id": "referrerEmail", "label": "Email", "type": "email", "width": "half" },
            { "id": "referrerRoute", "label": "Referral route", "type": "select", "width": "half", "options": ["GP", "Insurer", "Community service", "School", "Employer", "Other"] },
            { "id": "referrerNotes", "label": "Administrative notes", "type": "textarea", "width": "full", "rows": 3, "hint": "Contact and routing notes only. Clinical information stays in the clinical record." }
          ]
        }
      ]
    },
    {
      "key": "clinic-account",
      "name": "Clinic account",
      "description": "Clinic contact, rooms and billing details",
      "sections": [
        {
          "id": "clinic-details",
          "title": "Clinic details",
          "icon": "building",
          "fields": [
            { "id": "clinicType", "label": "Clinic type", "type": "select", "width": "half", "options": ["Solo practice", "Group practice", "Community clinic", "Hospital department", "Other"] },
            { "id": "clinicContact", "label": "Main contact email", "type": "email", "width": "half" },
            { "id": "clinicBillingEmail", "label": "Billing email", "type": "email", "width": "half" },
            { "id": "clinicRooms", "label": "Rooms available", "type": "number", "width": "half" },
            { "id": "clinicServices", "label": "Services offered", "type": "multiselect", "width": "full", "options": ["Individual therapy", "Couples therapy", "Family therapy", "Group sessions", "Assessments", "Other"] },
            { "id": "clinicNotes", "label": "Account notes", "type": "textarea", "width": "full", "rows": 3 }
          ]
        }
      ]
    }
  ]
